{
  "name": "stop-game-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "PWA multiplayer Stop / Tutti Frutti game in Playful Indie style",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "pnpm --filter @stop/api exec tsx ../../scripts/smoke-test.ts",
    "db:push": "pnpm --filter @stop/api db:push",
    "db:seed": "pnpm --filter @stop/api db:seed"
  },
  "devDependencies": {
    "turbo": "^2.4.4",
    "typescript": "^5.8.2"
  },
  "packageManager": "pnpm@11.5.0"
}
